  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HumanDecision": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "pelanggaran": {
            "type": "boolean",
            "title": "Pelanggaran"
          },
          "rule_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Rule Ids"
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Rationale"
          },
          "verification_notes": {
            "type": "string",
            "maxLength": 3000,
            "title": "Verification Notes",
            "default": ""
          },
          "evidence_basis": {
            "type": "string",
            "enum": [
              "text_only",
              "external_evidence"
            ],
            "title": "Evidence Basis",
            "default": "external_evidence"
          },
          "reuse": {
            "type": "string",
            "enum": [
              "none",
              "exact",
              "similar"
            ],
            "title": "Reuse",
            "default": "exact"
          },
          "valid_for_hours": {
            "type": "integer",
            "maximum": 2160.0,
            "minimum": 1.0,
            "title": "Valid For Hours",
            "default": 24
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "pelanggaran",
          "rationale"
        ],
        "title": "HumanDecision"
      },
      "RevokeRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 5,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "RevokeRequest"
      },
      "Submission": {
        "properties": {
          "platform": {
            "type": "string",
            "const": "x",
            "title": "Platform",
            "default": "x"
          },
          "content": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content"
          },
          "context": {
            "type": "string",
            "maxLength": 3000,
            "title": "Context",
            "default": ""
          },
          "context_key": {
            "type": "string",
            "maxLength": 200,
            "title": "Context Key",
            "default": ""
          },
          "external_reference_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "External Reference Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content"
        ],
        "title": "Submission"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "/moderation-lab"
    }
  ]
